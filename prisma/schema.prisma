generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("TURSO_DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  role      String   @default("student") // student | industry | admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  Student?
  industry Industry?
  userApiKey UserApiKey?
}

model Student {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  college     String?
  degree      String?
  year        Int?
  skills      String?  // JSON string array
  goals       String?  // JSON string array
  resumeUrl   String?
  createdAt   DateTime @default(now())

  applications Application[]
  scorecardReports ScorecardReport[]
  assessments Assessment[]
}

model Industry {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  companyName String
  sector      String?
  website     String?
  createdAt   DateTime @default(now())

  jobs Job[]
}

model Job {
  id           String   @id @default(cuid())
  industryId   String
  industry     Industry @relation(fields: [industryId], references: [id])
  title        String
  description  String
  skillsNeeded String?  // JSON string array
  type         String   @default("internship") // internship | placement
  location     String?
  isOpen       Boolean  @default(true)
  createdAt    DateTime @default(now())

  applications Application[]
}

model Application {
  id                String   @id @default(cuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  jobId             String
  job               Job      @relation(fields: [jobId], references: [id])
  status            String   @default("pending") // pending | accepted | rejected
  matchScore        Int?
  eligibilityStatus String?
  aiReason          String?
  createdAt         DateTime @default(now())
}

model SkillGapReport {
  id          String   @id @default(cuid())
  studentId   String
  report      String   // AI generated JSON report
  createdAt   DateTime @default(now())
}

model UserApiKey {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  encrypted String   // AES-256-GCM encrypted API key
  model     String   @default("google/gemma-4-31b-it:free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScorecardReport {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  report    String
  createdAt DateTime @default(now())
}

model Assessment {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  title       String   // e.g. "React & Node.js Assessment"
  score       Int?     // e.g. 15 (out of 20)
  total       Int      @default(20)
  status      String   @default("pending") // pending | completed
  createdAt   DateTime @default(now())

  questions   AssessmentQuestion[]
}

model AssessmentQuestion {
  id             String   @id @default(cuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id])
  question       String
  options        String   // JSON array of 4 options
  correctAnswer  String   // the correct option text
  userAnswer     String?  // what the student selected
  isCorrect      Boolean? // null until submitted
  createdAt      DateTime @default(now())
}